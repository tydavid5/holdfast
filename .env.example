# Holdfast needs no API keys or secrets to run.
# Copy this file to .env if a future build needs configuration.
# Leave every value empty unless you know what it is for.

# Optional: a public HTTPS URL where the built app is hosted (used for deep links).
# VITE_PUBLIC_URL=

# Optional: default network for the live path ("testnet" or "mainnet"). Testnet is the default.
# VITE_DEFAULT_NETWORK=testnet
